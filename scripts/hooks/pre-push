#!/bin/sh
# push = 배포다. 배포 화면이 깨질 상태면 여기서 끊는다.
#
# 카페 배포(public/cafe-ref)와 상세페이지 레퍼런스(public/detail-ref) 둘 다 본다.
# 캡처와 데이터를 같이 고치는데,
# 데이터만 커밋되면 로컬에는 파일이 남아 있어 npm run build 도 눈으로 보는 확인도
# 전부 통과한다. 배포 화면에서만 빈 칸이 된다.
# 08/22 배치는 277장, 08/25 배치는 245장이 그렇게 샜다.
#
# 2026-08-29: 검사를 푸시 범위로 좁혔다 (세영 제안 · 판단 민수).
# 전에는 무조건 작업 트리를 봐서, 한 세션이 캡처 작업 중이면 레퍼런스와
# 무관한 커밋(연락처 교체 등)까지 저장소 전체가 막혔다 — 08/28 실제 발생.
# 이제 푸시될 커밋이 레퍼런스 데이터·이미지를 건드릴 때만 검사한다.
# 범위를 계산할 수 없으면(새 브랜치 · 수동 실행 · git 오류) 전처럼 둘 다 검사한다.
#
# 급하면 git push --no-verify 로 건너뛸 수 있다. 다만 건너뛴 만큼 화면이 깨진다.

if ! command -v python >/dev/null 2>&1; then
  echo "pre-push: python 이 없어 레퍼런스 검증을 건너뜁니다."
  exit 0
fi

ZERO=0000000000000000000000000000000000000000
need_cafe=0
need_detail=0
saw_ref=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  saw_ref=1
  # 브랜치 삭제 — 배포될 내용이 없다
  [ "$local_sha" = "$ZERO" ] && continue
  # 새 브랜치 — 범위를 모르니 다 본다
  if [ "$remote_sha" = "$ZERO" ]; then
    need_cafe=1
    need_detail=1
    continue
  fi
  changed=$(git diff --name-only "$remote_sha".."$local_sha" 2>/dev/null) || {
    need_cafe=1
    need_detail=1
    continue
  }
  case "$changed" in
    *app/lib/cafe-distribution.ts*|*public/cafe-ref/*) need_cafe=1 ;;
  esac
  case "$changed" in
    *app/lib/detail-page-reference.ts*|*public/detail-ref/*) need_detail=1 ;;
  esac
done

# stdin 이 비어 있으면(수동 실행 등) 전처럼 둘 다 검사한다
if [ "$saw_ref" = "0" ]; then
  need_cafe=1
  need_detail=1
fi

if [ "$need_cafe" = "0" ] && [ "$need_detail" = "0" ]; then
  echo "pre-push: 이번 푸시는 레퍼런스 데이터·이미지를 건드리지 않아 검증을 건너뜁니다."
  exit 0
fi

ok=0
if [ "$need_cafe" = "1" ]; then
  python scripts/cafe-ref/apply.py --verify || ok=1
  echo
fi
if [ "$need_detail" = "1" ]; then
  python scripts/detail-ref/verify.py || ok=1
fi

if [ "$ok" = "0" ]; then
  exit 0
fi

echo
echo "──────────────────────────────────────────────"
echo " push 를 막았습니다 — 이대로 배포하면 화면이 깨집니다."
echo " 위에 적힌 git add 를 실행해 캡처까지 커밋한 뒤 다시 push 하세요."
echo " 정말 그냥 보내려면: git push --no-verify"
echo "──────────────────────────────────────────────"
exit 1
